---
import Layout from '../layouts/Layout.astro';
import NewsCard from '../components/NewsCard.astro';
import allPosts from '../data/all_posts.json';

const perPage = 20;
const totalPages = Math.ceil(allPosts.length / perPage);
const page = 1;
const posts = allPosts.slice((page - 1) * perPage, page * perPage);
---

<Layout title={`Лента новостей — БФ «Достижение-Дети»`}>
  <section class="relative py-16 bg-gradient-to-r from-slate-900 via-blue-950 to-blue-900 overflow-hidden">
    <div class="container mx-auto px-4 relative z-10 text-center">
      <span class="inline-block bg-white/20 backdrop-blur-sm rounded-full px-4 py-1 text-white/90 text-xs font-medium mb-4">📰 {allPosts.length} публикаций</span>
      <h1 class="text-3xl md:text-4xl font-bold text-white">Лента новостей</h1>
    </div>
  </section>

  <section class="py-8 bg-gray-50">
    <div class="container mx-auto px-4 max-w-6xl">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {posts.map((post) => (
          <NewsCard post={post} href={`/${post.slug}`} />
        ))}
      </div>

      <div class="mt-8 flex items-center justify-center gap-2">
        <span class="px-4 py-2 bg-primary-500 text-white rounded-lg text-sm font-medium">1</span>
        {totalPages > 1 && <a href="/news/page/2" class="px-4 py-2 bg-white rounded-lg text-sm text-gray-600 hover:bg-gray-100 border">2</a>}
        {totalPages > 2 && <a href="/news/page/3" class="px-4 py-2 bg-white rounded-lg text-sm text-gray-600 hover:bg-gray-100 border">3</a>}
        {totalPages > 3 && <span class="text-gray-400 text-sm">…</span>}
        {totalPages > 1 && <a href={`/news/page/${totalPages}`} class="px-4 py-2 bg-white rounded-lg text-sm text-gray-600 hover:bg-gray-100 border">{totalPages}</a>}
        {totalPages > 1 && <a href="/news/page/2" class="px-3 py-2 bg-white rounded-lg text-sm text-gray-600 hover:bg-gray-100 border">→</a>}
      </div>
    </div>
  </section>
</Layout>