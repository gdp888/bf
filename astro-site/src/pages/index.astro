---
import Layout from '../layouts/Layout.astro';
import fundData from '../data/fund.json';

const { fund_info, stories, stats } = fundData;
---

<Layout title="БФ «Достижение-Дети» — Помощь детям с особенностями здоровья">
  <!-- Hero Section -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-primary-600 via-primary-500 to-amber-400 opacity-95"></div>
    <div class="absolute inset-0 bg-[url('data:image/svg+xml,%3Csvg%20width%3D%2260%22%20height%3D%2260%22%20viewBox%3D%220%200%2060%2060%22%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%3E%3Cg%20fill%3D%22none%22%20fill-rule%3D%22evenodd%22%3E%3Cg%20fill%3D%22%23ffffff%22%20fill-opacity%3D%220.08%22%3E%3Cpath%20d%3D%22M36%2034v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6%2034v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6%204V0H4v4H0v2h4v4h2V6h4V4H6z%22%2F%3E%3C%2Fg%3E%3C%2Fg%3E%3C%2Fsvg%3E')]"></div>
    
    <div class="container mx-auto px-4 py-20 md:py-32 relative z-10">
      <div class="max-w-4xl mx-auto text-center">
        <div class="inline-flex items-center gap-2 bg-white/20 backdrop-blur-sm rounded-full px-4 py-2 mb-6">
          <span class="w-2 h-2 bg-green-400 rounded-full animate-pulse"></span>
          <span class="text-white/90 text-sm font-medium">Фонд работает • {fund_info.followers} подписчиков</span>
        </div>
        
        <h1 class="text-4xl md:text-6xl lg:text-7xl font-bold text-white mb-6 leading-tight">
          {fund_info.name}
        </h1>
        
        <p class="text-xl md:text-2xl text-white/90 mb-8 max-w-2xl mx-auto leading-relaxed">
          {fund_info.description}
        </p>
        
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a 
            href="/help" 
            class="group bg-white text-primary-600 hover:bg-gray-100 px-8 py-4 rounded-full font-semibold text-lg transition-all hover:shadow-xl hover:scale-105 flex items-center gap-2"
          >
            <span>❤️</span>
            <span>Помочь детям</span>
            <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
          <a 
            href="/stories" 
            class="bg-white/10 hover:bg-white/20 backdrop-blur-sm text-white border border-white/30 px-8 py-4 rounded-full font-semibold text-lg transition-all flex items-center gap-2"
          >
            <span>📖</span>
            <span>Истории детей</span>
          </a>
        </div>
        
        <p class="mt-12 text-white/80 text-lg font-medium tracking-wide">
          {fund_info.mission}
        </p>
      </div>
    </div>
    
    <!-- Wave divider -->
    <div class="absolute bottom-0 left-0 right-0">
      <svg viewBox="0 0 1440 120" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full">
        <path d="M0 120L60 110C120 100 240 80 360 70C480 60 600 60 720 65C840 70 960 80 1080 85C1200 90 1320 90 1380 90L1440 90V120H1380C1320 120 1200 120 1080 120C960 120 840 120 720 120C600 120 480 120 360 120C240 120 120 120 60 120H0Z" fill="#f9fafb"/>
      </svg>
    </div>
  </section>

  <!-- Stats Section -->
  <section class="py-16 bg-gray-50">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 max-w-4xl mx-auto">
        <div class="bg-white rounded-2xl p-6 shadow-lg shadow-primary-100 text-center hover:shadow-xl transition-shadow group">
          <div class="w-14 h-14 bg-gradient-to-br from-pink-400 to-red-400 rounded-xl flex items-center justify-center text-2xl mx-auto mb-3 group-hover:scale-110 transition-transform">
            🎬
          </div>
          <div class="text-3xl font-bold text-gray-800">{stats.clips}</div>
          <div class="text-sm text-gray-500 mt-1">Клипов</div>
        </div>
        
        <div class="bg-white rounded-2xl p-6 shadow-lg shadow-primary-100 text-center hover:shadow-xl transition-shadow group">
          <div class="w-14 h-14 bg-gradient-to-br from-blue-400 to-indigo-400 rounded-xl flex items-center justify-center text-2xl mx-auto mb-3 group-hover:scale-110 transition-transform">
            📸
          </div>
          <div class="text-3xl font-bold text-gray-800">{stats.photos}</div>
          <div class="text-sm text-gray-500 mt-1">Фото</div>
        </div>
        
        <div class="bg-white rounded-2xl p-6 shadow-lg shadow-primary-100 text-center hover:shadow-xl transition-shadow group">
          <div class="w-14 h-14 bg-gradient-to-br from-purple-400 to-violet-400 rounded-xl flex items-center justify-center text-2xl mx-auto mb-3 group-hover:scale-110 transition-transform">
            🎥
          </div>
          <div class="text-3xl font-bold text-gray-800">{stats.videos}</div>
          <div class="text-sm text-gray-500 mt-1">Видео</div>
        </div>
        
        <div class="bg-white rounded-2xl p-6 shadow-lg shadow-primary-100 text-center hover:shadow-xl transition-shadow group">
          <div class="w-14 h-14 bg-gradient-to-br from-amber-400 to-orange-400 rounded-xl flex items-center justify-center text-2xl mx-auto mb-3 group-hover:scale-110 transition-transform">
            📝
          </div>
          <div class="text-3xl font-bold text-gray-800">{stats.posts}</div>
          <div class="text-sm text-gray-500 mt-1">Постов</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Story -->
  <section class="py-20 bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-12">
          <span class="inline-block bg-amber-100 text-amber-700 px-4 py-1 rounded-full text-sm font-medium mb-4">
            🌟 История, которая трогает сердце
          </span>
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900">
            Им нужна наша помощь прямо сейчас
          </h2>
        </div>
        
        {stories.length > 0 && (
          <div class="bg-gradient-to-br from-blue-50 to-amber-50 rounded-3xl p-8 md:p-12 shadow-xl relative overflow-hidden">
            <div class="absolute top-0 right-0 w-64 h-64 bg-primary-200 rounded-full blur-3xl opacity-30 -translate-y-1/2 translate-x-1/2"></div>
            <div class="absolute bottom-0 left-0 w-64 h-64 bg-amber-200 rounded-full blur-3xl opacity-30 translate-y-1/2 -translate-x-1/2"></div>
            
            <div class="relative z-10">
              <div class="flex items-start gap-4 mb-6">
                <div class="w-16 h-16 bg-gradient-to-br from-primary-500 to-primary-600 rounded-2xl flex items-center justify-center text-3xl flex-shrink-0 shadow-lg">
                  👦
                </div>
                <div>
                  <h3 class="text-2xl font-bold text-gray-900">{stories[0].name}</h3>
                  <p class="text-gray-600">{stories[0].age} • {stories[0].condition}</p>
                  <span class="inline-flex items-center gap-1 mt-2 bg-green-100 text-green-700 px-3 py-1 rounded-full text-xs font-medium">
                    <span class="w-1.5 h-1.5 bg-green-500 rounded-full animate-pulse"></span>
                    {stories[0].status}
                  </span>
                </div>
              </div>
              
              <p class="text-gray-700 leading-relaxed mb-6 text-lg">
                {stories[0].story}
              </p>
              
              <div class="bg-white/80 backdrop-blur-sm rounded-xl p-4 mb-6 border border-primary-200">
                <p class="text-primary-800 font-medium">
                  💫 <strong>Цель:</strong> {stories[0].goal}
                </p>
              </div>
              
              <div className="flex flex-col sm:flex-row gap-4">
                <a href="/help" className="flex-1 bg-primary-500 hover:bg-primary-600 text-white text-center py-4 rounded-xl font-semibold transition-all hover:shadow-lg flex items-center justify-center gap-2">
                  <span>❤️</span> Помочь {stories[0].name.split(' ')[0]}
                </a>
                <a href="/stories" className="flex-1 bg-white hover:bg-gray-50 text-gray-700 text-center py-4 rounded-xl font-semibold transition-all border border-gray-200 flex items-center justify-center gap-2">
                  <span>📖</span> Все истории
                </a>
              </div>
            </div>
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- How to Help CTA -->
  <section class="py-20 bg-gradient-to-br from-gray-900 via-gray-800 to-gray-900 text-white relative overflow-hidden">
    <div class="absolute inset-0 bg-[url('data:image/svg+xml,%3Csvg%20width%3D%2240%22%20height%3D%2240%22%20viewBox%3D%220%200%2040%2040%22%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%3E%3Cg%20fill%3D%22none%22%20fill-rule%3D%22evenodd%22%3E%3Cg%20fill%3D%22%23ffffff%22%20fill-opacity%3D%220.05%22%3E%3Cpath%20d%3D%22M0%2020L20%200L40%2020L20%2040z%22%2F%3E%3C%2Fg%3E%3C%2Fg%3E%3C%2Fsvg%3E')]"></div>
    
    <div class="container mx-auto px-4 relative z-10">
      <div class="text-center max-w-3xl mx-auto">
        <h2 class="text-3xl md:text-5xl font-bold mb-6">
          Каждый из вас может стать<br/>частью наших проектов ✨
        </h2>
        <p class="text-xl text-gray-300 mb-10 leading-relaxed">
          Выберите удобный способ для добровольного пожертвования.<br/>
          Вместе мы сделаем мир добрее!
        </p>
        
        <a 
          href="/help"
          class="inline-flex items-center gap-3 bg-gradient-to-r from-amber-400 to-orange-500 hover:from-amber-500 hover:to-orange-600 text-gray-900 px-10 py-5 rounded-full font-bold text-lg transition-all hover:shadow-2xl hover:scale-105"
        >
          <span class="text-2xl">💝</span>
          <span>Выбрать способ помощи</span>
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- VK Widget Preview -->
  <section class="py-16 bg-gray-50">
    <div class="container mx-auto px-4">
      <div class="max-w-2xl mx-auto text-center">
        <h3 class="text-2xl font-bold text-gray-900 mb-4">
          Следите за нами в ВКонтакте
        </h3>
        <p class="text-gray-600 mb-8">
          Все новости, истории и отчёты публикуются в нашей группе
        </p>
        <a 
          href="https://vk.ru/dostigenie_deti"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-3 bg-[#0077FF] hover:bg-[#0066DD] text-white px-8 py-4 rounded-2xl font-semibold text-lg transition-all hover:shadow-xl hover:scale-105"
        >
          <svg class="w-7 h-7" fill="currentColor" viewBox="0 0 24 24"><path d="M13.162 18.994c.609 0 .858-.406.851-.915-.031-1.917.714-2.949 2.059-1.604 1.488 1.488 1.796 2.519 3.603 2.519h3.2c.808 0 1.126-.26 1.126-.668 0-.863-1.421-2.386-2.625-3.504-1.686-1.565-1.765-1.602-.313-3.486 1.801-2.339 4.157-5.336 1.847-5.336h-3.316c-.715 0-1.078.375-1.346.75-.043.06-.086.12-.13.179-.579.81-1.212 1.495-1.956 1.495-.79 0-.982-.527-1.031-1.363-.063-1.083.016-2.319.016-3.435 0-.99-.185-1.392-1.155-1.556-.24-.043-.48-.073-.72-.09C11.045 1.14 9.88 1 9.295 1 7.33 1 6.073 2.02 6.82 2.255c1.148.355 1.143 1.706 1.143 3.504 0 .963-.177 2.188-.89 2.188-.776 0-1.503-.97-2.383-2.175C3.896 4.68 3.41 4.006 2.985 4.006H.643c-.346 0-.563.165-.628.44-.057.24-.015.52.108.785.86 1.78 3.967 6.54 8.554 6.54 1.876 0 2.485-.778 2.485-1.778z"/></svg>
          <span>Перейти в группу VK</span>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
        </a>
      </div>
    </div>
  </section>
</Layout>
