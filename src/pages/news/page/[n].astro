---
import Layout from '../../../layouts/Layout.astro';
import NewsCard from '../../../components/NewsCard.astro';
import allPosts from '../../../data/all_posts.json';

export function getStaticPaths() {
  const perPage = 20;
  const totalPages = Math.ceil(allPosts.length / perPage);
  return Array.from({ length: totalPages - 1 }, (_, i) => ({
    params: { n: String(i + 2) },
    props: { page: i + 2, totalPages },
  }));
}

const { page, totalPages } = Astro.props;
const perPage = 20;
const start = (page - 1) * perPage;
const posts = allPosts.slice(start, start + perPage);
---

<Layout title={`Новости фонда — страница ${page} — БФ «Достижение-Дети»`}>
  <section class="relative py-16 bg-gradient-to-r from-slate-900 via-blue-950 to-blue-900 overflow-hidden">
    <div class="container mx-auto px-4 relative z-10 text-center">
      <span class="inline-block bg-white/20 backdrop-blur-sm rounded-full px-4 py-1 text-white/90 text-xs font-medium mb-4">📰 Страница {page} из {totalPages}</span>
      <h1 class="text-3xl md:text-4xl font-bold text-white">Новости фонда</h1>
    </div>
  </section>

  <section class="py-8 bg-gray-50">
    <div class="container mx-auto px-4 max-w-6xl">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {posts.map((post) => (
          <NewsCard post={post} href={`/news/${post.slug}/`} />
        ))}
      </div>

      <div class="mt-8 flex items-center justify-center gap-2">
        {page > 1 && <a href={page === 2 ? '/news/' : `/news/page/${page - 1}/`} class="px-3 py-2 bg-white rounded-lg text-sm text-gray-600 hover:bg-gray-100 border">←</a>}
        <a href="/news/" class="px-4 py-2 bg-white rounded-lg text-sm text-gray-600 hover:bg-gray-100 border">1</a>
        <span class="px-4 py-2 bg-primary-500 text-white rounded-lg text-sm font-medium">{page}</span>
        {page + 1 <= totalPages && <a href={`/news/page/${page + 1}/`} class="px-4 py-2 bg-white rounded-lg text-sm text-gray-600 hover:bg-gray-100 border">{page + 1}</a>}
        {page + 2 <= totalPages && <span class="text-gray-400 text-sm">…</span>}
        {page < totalPages && <a href={`/news/page/${totalPages}/`} class="px-4 py-2 bg-white rounded-lg text-sm text-gray-600 hover:bg-gray-100 border">{totalPages}</a>}
        {page < totalPages && <a href={page + 1 === 2 ? '/news/' : `/news/page/${page + 1}/`} class="px-3 py-2 bg-white rounded-lg text-sm text-gray-600 hover:bg-gray-100 border">→</a>}
      </div>
    </div>
  </section>
</Layout>