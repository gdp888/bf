---
import Layout from '../../../layouts/Layout.astro';
import allPosts from '../../../data/all_posts.json';

export function getStaticPaths() {
  const perPage = 20;
  const totalPages = Math.ceil(allPosts.length / perPage);
  return Array.from({ length: totalPages - 1 }, (_, i) => ({
    params: { n: String(i + 2) },
    props: { page: i + 2, totalPages },
  }));
}

const { page, totalPages } = Astro.props;
const perPage = 20;
const start = (page - 1) * perPage;
const posts = allPosts.slice(start, start + perPage);

function formatDate(d) {
  return new Date(d).toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' });
}
function truncate(t, n) {
  return t && t.length > n ? t.substring(0, n) + '…' : (t || '');
}
function likes(p) {
  return p.likes?.count ?? (typeof p.likes === 'number' ? p.likes : 0);
}
---

<Layout title={`Новости фонда — страница ${page} — БФ «Достижение-Дети»`}>
  <section class="relative py-16 bg-gradient-to-r from-slate-900 via-blue-950 to-blue-900 overflow-hidden">
    <div class="container mx-auto px-4 relative z-10 text-center">
      <span class="inline-block bg-white/20 backdrop-blur-sm rounded-full px-4 py-1 text-white/90 text-xs font-medium mb-4">📰 Страница {page} из {totalPages}</span>
      <h1 class="text-3xl md:text-4xl font-bold text-white">Новости фонда</h1>
    </div>
  </section>

  <section class="py-8 bg-gray-50">
    <div class="container mx-auto px-4 max-w-3xl">
      <div class="space-y-3">
        {posts.map((post) => (
          <a href={`/news/${post.slug}/`} class="block bg-white rounded-xl shadow-sm hover:shadow-md transition border border-gray-100 overflow-hidden group">
            <div class="flex gap-3 p-3">
              {(() => {
                const img = post.images?.[0] || post.videos?.[0]?.image;
                return img ? (
                  <div class="w-20 h-20 rounded-lg overflow-hidden flex-shrink-0 bg-gray-100">
                    <img src={img} alt="" class="w-full h-full object-cover" loading="lazy" />
                  </div>
                ) : null;
              })()}
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 text-xs text-gray-400 mb-0.5">
                  <span>{formatDate(post.date)}</span>
                  {post.videos?.length > 0 && <span class="text-red-500">🎬</span>}
                </div>
                <p class="text-sm text-gray-800 leading-snug line-clamp-2">
                  {truncate(post.text, 200) || <span class="text-gray-400 italic">Нет текста</span>}
                </p>
                <div class="flex items-center gap-2 mt-1 text-xs text-gray-400">
                  <span>❤️ {likes(post)}</span>
                  <span>💬 {post.comments?.count || 0}</span>
                </div>
              </div>
            </div>
          </a>
        ))}
      </div>

      <div class="mt-8 flex items-center justify-center gap-2">
        <a href="/news/" class="px-3 py-2 bg-white rounded-lg text-sm text-gray-600 hover:bg-gray-100 border">←</a>
        <a href="/news/" class="px-4 py-2 bg-white rounded-lg text-sm text-gray-600 hover:bg-gray-100 border">1</a>
        <span class="px-4 py-2 bg-primary-500 text-white rounded-lg text-sm font-medium">{page}</span>
        {page + 1 <= totalPages && <a href={`/news/page/${page + 1}/`} class="px-4 py-2 bg-white rounded-lg text-sm text-gray-600 hover:bg-gray-100 border">{page + 1}</a>}
        {page + 2 <= totalPages && <span class="text-gray-400 text-sm">…</span>}
        {page < totalPages && <a href={`/news/page/${totalPages}/`} class="px-4 py-2 bg-white rounded-lg text-sm text-gray-600 hover:bg-gray-100 border">{totalPages}</a>}
        {page + 1 <= totalPages && <a href={`/news/page/${page + 1}/`} class="px-3 py-2 bg-white rounded-lg text-sm text-gray-600 hover:bg-gray-100 border">→</a>}
      </div>
    </div>
  </section>
</Layout>