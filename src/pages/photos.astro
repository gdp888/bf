---
import Layout from '../layouts/Layout.astro';
import JsonLd from '../components/JsonLd.astro';
import albums from '../data/albums.json';

// транслит для URL альбомов
const MAP = {
  а: 'a', б: 'b', в: 'v', г: 'g', д: 'd', е: 'e', ё: 'e', ж: 'zh', з: 'z',
  и: 'i', й: 'y', к: 'k', л: 'l', м: 'm', н: 'n', о: 'o', п: 'p', р: 'r',
  с: 's', т: 't', у: 'u', ф: 'f', х: 'h', ц: 'ts', ч: 'ch', ш: 'sh',
  щ: 'sch', ъ: '', ы: 'y', ь: '', э: 'e', ю: 'yu', я: 'ya',
};
function slugify(t) {
  return t.toLowerCase().split('').map((c) => MAP[c] ?? c).join('')
    .replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '').slice(0, 60) || 'album';
}
function pretty(t) {
  return t.charAt(0).toUpperCase() + t.slice(1).replace(/_/g, ' ');
}
function plural(n) {
  const m10 = n % 10, m100 = n % 100;
  if (m10 === 1 && m100 !== 11) return 'фотография';
  if (m10 >= 2 && m10 <= 4 && (m100 < 10 || m100 >= 20)) return 'фотографии';
  return 'фотографий';
}

const totalPhotos = albums.reduce((s, a) => s + a.count, 0);
const prepared = albums.map((a) => ({ ...a, slug: slugify(a.title), title: pretty(a.title) }));

// og:image — обложка самого содержательного альбома
const cover = prepared.slice().sort((a, b) => b.count - a.count)[0]?.photos?.[0]?.src || '/images/fund-cover.jpg';

// ─── Schema.org: страница-коллекция альбомов ───
const BASE = Astro.site!.href;
const gallerySchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Фотогалерея — БФ «Достижение-Дети»',
  url: new URL('photos/', Astro.site).href,
  inLanguage: 'ru',
  isPartOf: { '@id': `${BASE}#website` },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: prepared.length,
    itemListElement: prepared.map((a, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: a.title,
      url: new URL(`photos/${a.slug}/`, Astro.site).href,
    })),
  },
};
---

<Layout
  title={`Фотогалерея — БФ «Достижение-Дети»`}
  description={`Фотографии фонда: наши подопечные, праздники, мероприятия и отчеты по сборам. ${totalPhotos} ${plural(totalPhotos)} помощи детям с особенностями здоровья.`}
  image={cover}
>
  <JsonLd slot="head" data={[gallerySchema]} />
  <section class="relative py-16 bg-gradient-to-r from-slate-900 via-blue-950 to-blue-900 overflow-hidden">
    <div class="container mx-auto px-4 relative z-10 text-center">
      <span class="inline-block bg-white/20 backdrop-blur-sm rounded-full px-4 py-1 text-white/90 text-xs font-medium mb-4">📸 {totalPhotos} {plural(totalPhotos)}</span>
      <h1 class="text-3xl md:text-4xl font-bold text-white">Фотогалерея фонда</h1>
      <p class="text-white/80 mt-3 max-w-2xl mx-auto text-sm md:text-base">
        Наши подопечные, праздники, поездки и будни фонда — всё, чем живёт «Достижение-Дети».
        Каждый снимок — часть большой общей работы.
      </p>
    </div>
  </section>

  <section class="py-10 bg-gray-50">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {prepared.map((album) => (
          <a
            href={`/photos/${album.slug}/`}
            class="group bg-white rounded-xl shadow-sm hover:shadow-lg transition overflow-hidden border border-gray-100 flex flex-col"
          >
            <div class="aspect-[4/3] overflow-hidden bg-gray-100 relative">
              <img
                src={album.photos[0]?.src}
                alt={`${album.title} — фото`}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                loading="lazy"
                decoding="async"
                width="800"
                height="600"
              />
              <span class="absolute bottom-3 right-3 bg-black/60 backdrop-blur-sm text-white text-xs font-medium px-2.5 py-1 rounded-full">
                {album.count} {plural(album.count)}
              </span>
            </div>
            <div class="p-4 flex items-center justify-between gap-2">
              <h2 class="font-semibold text-gray-800 group-hover:text-primary-600 transition-colors">{album.title}</h2>
              <span class="text-gray-300 group-hover:text-primary-500 group-hover:translate-x-1 transition-all flex-shrink-0" aria-hidden="true">→</span>
            </div>
          </a>
        ))}
      </div>

      <div class="mt-12 bg-white rounded-xl border border-gray-100 shadow-sm p-6 text-center">
        <p class="text-gray-600 text-sm mb-4">Хотите помочь детям с этих фотографий?</p>
        <a
          href="/help/"
          class="inline-flex items-center gap-2 bg-gradient-to-r from-amber-400 to-orange-500 hover:from-amber-500 hover:to-orange-600 text-gray-900 px-6 py-3 rounded-full font-bold shadow-lg shadow-orange-500/25 hover:shadow-xl hover:scale-105 transition-all"
        >
          <span>💝</span><span>Помочь детям</span>
        </a>
      </div>
    </div>
  </section>
</Layout>
