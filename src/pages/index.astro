---
import Layout from '../layouts/Layout.astro';
import JsonLd from '../components/JsonLd.astro';
import fundData from '../data/fund.json';

const { fund_info, stories, stats } = fundData;
// кадрирование фото: голова ребёнка не должна срезаться (классы литералами для Tailwind JIT)
const POS_CLASS = {
  'top': 'object-top',
  'center 30%': 'object-[position:center_30%]',
};
// витрина сборов на главной: горячие сверху, закрытые ниже
const activeStories = stories.filter((s) => !s.status.includes('закрыт'));
const closedStories = stories.filter((s) => s.status.includes('закрыт'));

// пагинация завершённых сборов: первая порция на главной, хвост — на /page/2/ и далее
const CLOSED_PER_PAGE = 8;
const closedFirstPage = closedStories.slice(0, CLOSED_PER_PAGE);
const totalPages = Math.ceil(closedStories.length / CLOSED_PER_PAGE);
const olderPages = totalPages > 1;

// ─── Schema.org: сайт ───
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${Astro.site!.href}#website`,
  name: 'БФ «Достижение-Дети»',
  url: Astro.site!.href,
  inLanguage: 'ru',
  publisher: { '@id': `${Astro.site!.href}#ngo` },
};
---

<Layout title="БФ «Достижение-Дети» — Помощь детям с особенностями здоровья">
  <JsonLd slot="head" data={[websiteSchema]} />
  <!-- Hero: компактный, конкретика вместо общих слов -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 bg-[url('/images/fund-cover.jpg')] bg-cover bg-center"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-slate-900/92 via-blue-950/85 to-blue-900/75"></div>

    <div class="container mx-auto px-4 py-14 md:py-20 relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <span class="inline-block bg-white/15 backdrop-blur-sm rounded-full px-4 py-1.5 text-white/90 text-sm font-medium mb-5">
          💙 {fund_info.name}
        </span>
        <h1 class="text-3xl md:text-5xl lg:text-6xl font-bold text-white mb-4 leading-tight">
          Помощь детям с ДЦП<br class="hidden md:block" /> и особенностями здоровья
        </h1>

        <p class="text-base md:text-xl text-white/80 mb-8 max-w-2xl mx-auto leading-relaxed">
          Мы оплачиваем курсы реабилитации — и дети делают первые шаги
          и произносят первые слова. Помогите ещё одному ребёнку.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href="/help/"
            class="group bg-gradient-to-r from-amber-400 to-orange-500 hover:from-amber-500 hover:to-orange-600 text-gray-900 px-8 py-4 rounded-full font-bold text-lg transition-all hover:shadow-2xl hover:scale-105 flex items-center gap-2"
          >
            <span>💝</span>
            <span>Помочь сейчас</span>
            <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
          <a
            href="#sbory"
            class="text-white/90 hover:text-white border-b-2 border-white/30 hover:border-white/70 pb-0.5 font-medium transition-colors"
          >
            К текущим сборам ↓
          </a>
        </div>
      </div>
    </div>

    <!-- Wave divider -->
    <div class="absolute bottom-0 left-0 right-0">
      <svg viewBox="0 0 1440 120" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full">
        <path d="M0 120L60 110C120 100 240 80 360 70C480 60 600 60 720 65C840 70 960 80 1080 85C1200 90 1320 90 1380 90L1440 90V120H1380C1320 120 1200 120 1080 120C960 120 840 120 720 120C600 120 480 120 360 120C240 120 120 120 60 120H0Z" fill="#ffffff"/>
      </svg>
    </div>
  </section>

  <!-- Urgent Fundraising Cards -->
  <section id="sbory" class="py-16 md:py-20 bg-white scroll-mt-16">
    <div class="container mx-auto px-4">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-12">
          <span class="inline-block bg-red-100 text-red-600 px-4 py-1 rounded-full text-sm font-medium mb-4">
            🔥 Горячие сборы
          </span>
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900">
            Помощь нужна прямо сейчас
          </h2>
          <p class="text-gray-600 mt-4 text-lg">
            Каждое пожертвование — это шаг ребёнка к выздоровлению. Присоединяйтесь!
          </p>
        </div>

        <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
          {activeStories.map((story) => (
            <article class="bg-white rounded-3xl shadow-xl overflow-hidden border border-gray-100 transition-all duration-300 group hover:shadow-2xl hover:-translate-y-1 flex flex-col relative">
              <a href={`/news/${story.post_slug}/`} class="absolute inset-0 z-10" aria-label={`История: ${story.name}`}></a>
              <div class="relative h-56 overflow-hidden">
                {story.image ? (
                  <img
                    src={story.image}
                    alt={story.name}
                    class={`w-full h-full object-cover ${POS_CLASS[story.image_pos] || ''} group-hover:scale-105 transition-transform duration-500`}
                    loading="lazy"
                  />
                ) : (
                  <div class="w-full h-full bg-gradient-to-br from-primary-400 via-primary-500 to-amber-400 flex items-center justify-center">
                    <span class="text-8xl drop-shadow-lg group-hover:scale-110 transition-transform duration-300">👧</span>
                  </div>
                )}
                <span class="absolute top-4 left-4 inline-flex items-center gap-1.5 bg-red-500/95 backdrop-blur-sm text-white px-3.5 py-1.5 rounded-full text-xs font-bold shadow-lg">
                  <span class="w-2 h-2 bg-white rounded-full animate-pulse"></span>
                  Срочный сбор
                </span>
              </div>

              <div class="p-6 md:p-7 flex flex-col flex-1">
                <h3 class="text-2xl font-bold text-gray-900 group-hover:text-primary-700 transition-colors">{story.name}</h3>
                <p class="text-gray-500 text-sm mt-1">{story.age} • {story.condition}</p>
                <p class="text-gray-700 mt-4 leading-relaxed flex-1">{story.goal}</p>
                <p class="text-sm font-medium text-primary-600 mt-5 opacity-0 group-hover:opacity-100 transition-opacity">
                  Читать историю →
                </p>
              </div>
            </article>
          ))}
        </div>

        <p class="text-center text-gray-500 text-sm mt-10">
          Прочитать всю историю каждого ребёнка можно в <a href="/news/" class="text-primary-600 hover:underline font-medium">ленте новостей →</a>
        </p>
      </div>
    </div>
  </section>

  <!-- Завершённые сборы: соц. доказательство -->
  {closedStories.length > 0 && (
    <section class="py-16 bg-gray-50">
      <div class="container mx-auto px-4">
        <div class="text-center mb-10">
          <span class="inline-block bg-emerald-100 text-emerald-700 px-4 py-1 rounded-full text-sm font-medium mb-3">
            ✅ Сборы завершены
          </span>
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900">
            Спасибо! Эти сборы закрыты
          </h2>
          <p class="text-gray-600 mt-4 text-lg max-w-xl mx-auto">
            Благодаря вашей помощи дети прошли лечение и реабилитацию.
            Мы доводим каждый сбор до конца — и отчитываемся о результатах.
          </p>
        </div>

        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3 max-w-6xl mx-auto">
          {closedFirstPage.map((story) => (
            <article class="bg-white rounded-3xl shadow-lg overflow-hidden border border-emerald-100 transition-all duration-300 group hover:shadow-xl flex flex-col relative">
              <a href={`/news/${story.post_slug}/`} class="absolute inset-0 z-10" aria-label={`История: ${story.name}`}></a>
              <div class="relative h-48 overflow-hidden">
                {story.image ? (
                  <img
                    src={story.image}
                    alt={story.name}
                    class={`w-full h-full object-cover ${POS_CLASS[story.image_pos] || ''} group-hover:scale-105 transition-transform duration-500`}
                    loading="lazy"
                  />
                ) : (
                  <div class="w-full h-full bg-gradient-to-br from-emerald-300 to-green-400 flex items-center justify-center">
                    <span class="text-7xl">👦</span>
                  </div>
                )}
                <span class="absolute top-4 left-4 inline-flex items-center gap-1.5 bg-emerald-500/95 backdrop-blur-sm text-white px-3 py-1.5 rounded-full text-xs font-bold shadow-lg">
                  ✅ Сбор закрыт — спасибо!
                </span>
              </div>
              <div class="p-6 flex flex-col flex-1">
                <h3 class="text-xl font-bold text-gray-900">{story.name}</h3>
                <p class="text-gray-500 text-sm mt-1">{story.age} • {story.condition}</p>
                <p class="text-gray-600 mt-3 leading-relaxed flex-1 text-sm">{story.goal}</p>
                <p class="text-sm font-medium text-emerald-600 mt-4">
                  Как всё прошло →
                </p>
              </div>
            </article>
          ))}
        </div>

        {olderPages && (
          <div class="text-center mt-10">
            <a
              href="/page/2/"
              class="inline-flex items-center gap-2 bg-white hover:bg-gray-50 border border-gray-200 text-gray-700 px-6 py-3 rounded-full font-medium transition-colors shadow-sm"
            >
              Предыдущие сборы <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </a>
          </div>
        )}
      </div>
    </section>
  )}

  <!-- Stats: цифры, которые говорят о работе фонда -->
  <section class="py-16 bg-white">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 max-w-4xl mx-auto">
        <div class="bg-white rounded-2xl p-6 shadow-lg shadow-primary-100 text-center hover:shadow-xl transition-shadow group">
          <div class="w-14 h-14 bg-gradient-to-br from-rose-400 to-red-400 rounded-xl flex items-center justify-center text-2xl mx-auto mb-3 group-hover:scale-110 transition-transform">
            ❤️
          </div>
          <div class="text-3xl font-bold text-gray-800">{activeStories.length}</div>
          <div class="text-sm text-gray-500 mt-1">ребёнка ждут помощи сейчас</div>
        </div>

        

        <div class="bg-white rounded-2xl p-6 shadow-lg shadow-primary-100 text-center hover:shadow-xl transition-shadow group">
          <div class="w-14 h-14 bg-gradient-to-br from-blue-400 to-indigo-400 rounded-xl flex items-center justify-center text-2xl mx-auto mb-3 group-hover:scale-110 transition-transform">
            📰
          </div>
          <div class="text-3xl font-bold text-gray-800">{stats.posts}</div>
          <div class="text-sm text-gray-500 mt-1">историй о нашей работе</div>
        </div>

        <div class="bg-white rounded-2xl p-6 shadow-lg shadow-primary-100 text-center hover:shadow-xl transition-shadow group">
          <div class="w-14 h-14 bg-gradient-to-br from-amber-400 to-orange-400 rounded-xl flex items-center justify-center text-2xl mx-auto mb-3 group-hover:scale-110 transition-transform">
            👥
          </div>
          <div class="text-3xl font-bold text-gray-800">{fund_info.followers}</div>
          <div class="text-sm text-gray-500 mt-1">подписчиков в VK</div>
        </div>
      </div>
    </div>
  </section>

  <!-- How to Help CTA -->
  <section class="py-20 bg-gradient-to-br from-gray-900 via-gray-800 to-gray-900 text-white relative overflow-hidden">
    <div class="absolute inset-0 bg-[url('data:image/svg+xml,%3Csvg%20width%3D%2240%22%20height%3D%2240%22%20viewBox%3D%220%200%2040%2040%22%20xmlns%3D%22http%3A%2F%2Fwww%2Ew3%2Eorg%2F2000%2Fsvg%22%3E%3Cg%20fill%3D%22none%22%20fill-rule%3D%22evenodd%22%3E%3Cg%20fill%3D%22%23ffffff%22%20fill-opacity%3D%220.05%22%3E%3Cpath%20d%3D%22M0%2020L20%200L40%2020L20%2040z%22%2F%3E%3C%2Fg%3E%3C%2Fg%3E%3C%2Fsvg%3E')]"></div>

    <div class="container mx-auto px-4 relative z-10">
      <div class="text-center max-w-3xl mx-auto">
        <h2 class="text-3xl md:text-5xl font-bold mb-6">
          Каждый из вас может стать<br/>частью наших проектов ✨
        </h2>
        <p class="text-xl text-gray-300 mb-10 leading-relaxed">
          Выберите удобный способ для добровольного пожертвования.<br/>
          Вместе мы сделаем мир добрее!
        </p>

        <a
          href="/help/"
          class="inline-flex items-center gap-3 bg-gradient-to-r from-amber-400 to-orange-500 hover:from-amber-500 hover:to-orange-600 text-gray-900 px-10 py-5 rounded-full font-bold text-lg transition-all hover:shadow-2xl hover:scale-105"
        >
          <span class="text-2xl">💝</span>
          <span>Выбрать способ помощи</span>
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- VK Widget Preview -->
  <section class="py-16 bg-gray-50">
    <div class="container mx-auto px-4">
      <div class="max-w-2xl mx-auto text-center">
        <h3 class="text-2xl font-bold text-gray-900 mb-4">
          Следите за нами в ВКонтакте
        </h3>
        <p class="text-gray-600 mb-8">
          Все новости, истории и отчёты публикуются в нашей группе
        </p>
        <a
          href="https://vk.ru/dostigenie_deti"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-3 bg-[#0077FF] hover:bg-[#0066DD] text-white px-8 py-4 rounded-2xl font-semibold text-lg transition-all hover:shadow-xl hover:scale-105"
        >
          <svg class="w-7 h-7" fill="currentColor" viewBox="0 0 24 24"><path d="M13.162 18.994c.609 0 .858-.406.851-.915-.031-1.917.714-2.949 2.059-1.604 1.488 1.488 1.796 2.519 3.603 2.519h3.2c.808 0 1.126-.26 1.126-.668 0-.863-1.421-2.386-2.625-3.504-1.686-1.565-1.765-1.602-.313-3.486 1.801-2.339 4.157-5.336 1.847-5.336h-3.316c-.715 0-1.078.375-1.346.75-.043.06-.086.12-.13.179-.579.81-1.212 1.495-1.956 1.495-.79 0-.982-.527-1.031-1.363-.063-1.083.016-2.319.016-3.435 0-.99-.185-1.392-1.155-1.556-.24-.043-.48-.073-.72-.09C11.045 1.14 9.88 1 9.295 1 7.33 1 6.073 2.02 6.82 2.255c1.148.355 1.143 1.706 1.143 3.504 0 .963-.177 2.188-.89 2.188-.776 0-1.503-.97-2.383-2.175C3.896 4.68 3.41 4.006 2.985 4.006H.643c-.346 0-.563.165-.628.44-.057.24-.015.52.108.785.86 1.78 3.967 6.54 8.554 6.54 1.876 0 2.485-.778 2.485-1.778z"/></svg>
          <span>Перейти в группу VK</span>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
        </a>
      </div>
    </div>
  </section>
</Layout>
