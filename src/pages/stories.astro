---
import Layout from '../layouts/Layout.astro';
import fundData from '../data/fund.json';

const { stories, fund_info } = fundData;
// кадрирование фото: классы литералами для Tailwind JIT
const POS_CLASS = {
  'top': 'object-top',
  'center 30%': 'object-[position:center_30%]',
};
---

<Layout title="Истории детей — БФ «Достижение-Дети»">
  <!-- Hero -->
  <section class="relative py-20 bg-gradient-to-br from-pink-500 via-red-400 to-orange-400 overflow-hidden">
    <div class="absolute inset-0 bg-[url('data:image/svg+xml,%3Csvg%20width%3D%2260%22%20height%3D%2260%22%20viewBox%3D%220%200%2060%2060%22%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%3E%3Cg%20fill%3D%22none%22%20fill-rule%3D%22evenodd%22%3E%3Cg%20fill%3D%22%23ffffff%22%20fill-opacity%3D%220.1%22%3E%3Ccircle%20cx%3D%2230%22%20cy%3D%2230%22%20r%3D%224%22%2F%3E%3C%2Fg%3E%3C%2Fg%3E%3C%2Fsvg%3E')]"></div>
    
    <div class="container mx-auto px-4 relative z-10 text-center">
      <span class="inline-block bg-white/20 backdrop-blur-sm rounded-full px-4 py-2 text-white/90 text-sm font-medium mb-6">
        📖 Реальные истории
      </span>
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6">
        Истории наших детей
      </h1>
      <p class="text-xl text-white/90 max-w-2xl mx-auto">
        Каждый ребёнок — это уникальная история борьбы, надежды и веры в лучшее.
        Познакомьтесь с теми, кому нужна ваша помощь.
      </p>
    </div>
    
    <div class="absolute bottom-0 left-0 right-0">
      <svg viewBox="0 0 1440 120" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full">
        <path d="M0 120L60 110C120 100 240 80 360 70C480 60 600 60 720 65C840 70 960 80 1080 85C1200 90 1320 90 1380 90L1440 90V120H1380C1320 120 1200 120 1080 120C960 120 840 120 720 120C600 120 480 120 360 120C240 120 120 120 60 120H0Z" fill="#f9fafb"/>
      </svg>
    </div>
  </section>

  <!-- Stories Grid -->
  <section class="py-16 bg-gray-50">
    <div class="container mx-auto px-4">
      {stories.length > 0 ? (
        <div class="grid gap-8 max-w-4xl mx-auto">
          {stories.map((story) => (
            <article class="bg-white rounded-3xl shadow-xl overflow-hidden hover:shadow-2xl transition-all duration-300 group">
              <div class="md:flex">
                <div class="md:w-1/3 bg-gradient-to-br from-primary-400 to-primary-600 flex items-center justify-center overflow-hidden">
                  {story.image ? (
                    <img src={story.image} alt={story.name} class={`w-full h-64 md:h-full object-cover ${POS_CLASS[story.image_pos] || ''}`} loading="lazy" />
                  ) : (
                    <div class="text-8xl group-hover:scale-110 transition-transform duration-300 py-16">👦</div>
                  )}
                </div>
                <div class="md:w-2/3 p-8 md:p-10">
                  <div class="flex items-start justify-between mb-4">
                    <div>
                      <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-2">{story.name}</h2>
                      <p class="text-gray-600">{story.age} • {story.condition}</p>
                    </div>
                    <span class={`px-3 py-1 rounded-full text-xs font-medium ${
                      story.status.includes('Активный') 
                        ? 'bg-green-100 text-green-700' 
                        : 'bg-gray-100 text-gray-600'
                    }`}>
                      {story.status === 'Активный сбор средств' && (
                        <span class="inline-flex items-center gap-1">
                          <span class="w-1.5 h-1.5 bg-green-500 rounded-full animate-pulse"></span>
                          {story.status}
                        </span>
                      )}
                    </span>
                  </div>
                  
                  <p class="text-gray-700 leading-relaxed mb-6 text-lg">
                    {story.story}
                  </p>
                  
                  <div class="bg-primary-50 border border-primary-200 rounded-xl p-4 mb-6">
                    <p class="text-primary-800">
                      <strong>💫 Цель:</strong> {story.goal}
                    </p>
                  </div>
                  
                  <a 
                    href="/help"
                    class="inline-flex items-center gap-2 bg-gradient-to-r from-primary-500 to-primary-600 hover:from-primary-600 hover:to-primary-700 text-white px-6 py-3 rounded-xl font-semibold transition-all hover:shadow-lg"
                  >
                    <span>❤️</span> Помочь {story.name.split(' ')[0]}
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="text-center py-20">
          <div class="text-6xl mb-4">📝</div>
          <h3 class="text-2xl font-semibold text-gray-700 mb-2">Истории скоро появятся</h3>
          <p class="text-gray-500">Мы готовим информацию о детях, которым нужна помощь</p>
        </div>
      )}
      
      <!-- CTA -->
      <div class="mt-16 text-center">
        <div class="bg-gradient-to-br from-gray-900 to-gray-800 rounded-3xl p-10 md:p-16 text-white relative overflow-hidden">
          <div class="absolute top-0 right-0 w-64 h-64 bg-primary-500 rounded-full blur-3xl opacity-20 -translate-y-1/2 translate-x-1/2"></div>
          
          <div class="relative z-10">
            <h3 class="text-3xl md:text-4xl font-bold mb-4">
              Хотите помочь?
            </h3>
            <p class="text-gray-300 text-lg mb-8 max-w-xl mx-auto">
              Любая сумма важна. Вместе мы можем изменить жизнь этих детей к лучшему.
            </p>
            <a 
              href="/help"
              class="inline-flex items-center gap-2 bg-gradient-to-r from-amber-400 to-orange-500 hover:from-amber-500 hover:to-orange-600 text-gray-900 px-8 py-4 rounded-full font-bold transition-all hover:shadow-xl hover:scale-105"
            >
              <span>💝</span> Выбрать способ помощи
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
