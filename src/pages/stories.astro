---
import Layout from '../layouts/Layout.astro';
import fundData from '../data/fund.json';

const { stories, fund_info } = fundData;
// кадрирование фото: классы литералами для Tailwind JIT
const POS_CLASS = {
  'top': 'object-top',
  'center 30%': 'object-[position:center_30%]',
};
// горячие сборы — сверху, закрытые — ниже (соц. доказательство: фонд доводит до конца)
const activeStories = stories.filter((s) => !s.status.includes('закрыт'));
const closedStories = stories.filter((s) => s.status.includes('закрыт'));
---

<Layout title="Истории детей — БФ «Достижение-Дети»">
  <!-- Компактный hero -->
  <section class="relative py-12 md:py-16 bg-gradient-to-r from-slate-900 via-blue-950 to-blue-900 overflow-hidden">
    <div class="absolute inset-0 bg-[url('data:image/svg+xml,%3Csvg%20width%3D%2260%22%20height%3D%2260%22%20viewBox%3D%220%200%2060%2060%22%20xmlns%3D%22http%3A%2F%2Fwww%2Ew3%2Eorg%2F2000%2Fsvg%22%3E%3Cg%20fill%3D%22none%22%20fill-rule%3D%22evenodd%22%3E%3Cg%20fill%3D%22%23ffffff%22%20fill-opacity%3D%220.1%22%3E%3Ccircle%20cx%3D%2230%22%20cy%3D%2230%22%20r%3D%224%22%2F%3E%3C%2Fg%3E%3C%2Fg%3E%3C%2Fsvg%3E')]"></div>

    <div class="container mx-auto px-4 relative z-10 text-center">
      <span class="inline-block bg-white/20 backdrop-blur-sm rounded-full px-4 py-1.5 text-white/90 text-sm font-medium mb-4">
        📖 Реальные истории
      </span>
      <h1 class="text-3xl md:text-5xl font-bold text-white mb-4">
        Истории наших детей
      </h1>
      <p class="text-lg text-white/90 max-w-2xl mx-auto">
        Каждый ребёнок — это уникальная история борьбы, надежды и веры в лучшее.
        Познакомьтесь с теми, кому нужна ваша помощь.
      </p>
    </div>

    <div class="absolute bottom-0 left-0 right-0">
      <svg viewBox="0 0 1440 120" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full">
        <path d="M0 120L60 110C120 100 240 80 360 70C480 60 600 60 720 65C840 70 960 80 1080 85C1200 90 1320 90 1380 90L1440 90V120H1380C1320 120 1200 120 1080 120C960 120 840 120 720 120C600 120 480 120 360 120C240 120 120 120 60 120H0Z" fill="#f9fafb"/>
      </svg>
    </div>
  </section>

  <!-- Горячие сборы -->
  <section class="py-14 bg-gray-50">
    <div class="container mx-auto px-4">
      <div class="text-center mb-10">
        <span class="inline-block bg-red-100 text-red-600 px-4 py-1 rounded-full text-sm font-medium mb-3">
          🔥 Горячие сборы
        </span>
        <h2 class="text-2xl md:text-3xl font-bold text-gray-900">
          Помощь нужна прямо сейчас
        </h2>
      </div>

      {activeStories.length > 0 ? (
        <div class="grid gap-8 max-w-4xl mx-auto">
          {activeStories.map((story) => (
            <article class="bg-white rounded-3xl shadow-xl overflow-hidden hover:shadow-2xl transition-all duration-300 group border-2 border-red-100">
              <div class="md:flex">
                <div class="md:w-1/3 bg-gradient-to-br from-primary-400 to-primary-600 flex items-center justify-center overflow-hidden relative">
                  {story.image ? (
                    <img src={story.image} alt={story.name} class={`w-full h-64 md:h-full object-cover ${POS_CLASS[story.image_pos] || ''}`} loading="lazy" />
                  ) : (
                    <div class="text-8xl group-hover:scale-110 transition-transform duration-300 py-16">👦</div>
                  )}
                  <span class="absolute top-4 left-4 inline-flex items-center gap-1.5 bg-red-500/95 backdrop-blur-sm text-white px-3 py-1.5 rounded-full text-xs font-bold shadow-lg">
                    <span class="w-2 h-2 bg-white rounded-full animate-pulse"></span>
                    Идёт сбор
                  </span>
                </div>
                <div class="md:w-2/3 p-8 md:p-10">
                  <div class="mb-4">
                    <h3 class="text-2xl md:text-3xl font-bold text-gray-900 mb-2">{story.name}</h3>
                    <p class="text-gray-600">{story.age} • {story.condition}</p>
                  </div>

                  <p class="text-gray-700 leading-relaxed mb-6 text-lg">
                    {story.story}
                  </p>

                  <div class="bg-primary-50 border border-primary-200 rounded-xl p-4 mb-6">
                    <p class="text-primary-800">
                      <strong>💫 Цель:</strong> {story.goal}
                    </p>
                  </div>

                  <div class="flex flex-col sm:flex-row sm:flex-wrap gap-3">
                    <a
                      href="/help/"
                      class="inline-flex items-center justify-center gap-2 bg-gradient-to-r from-amber-400 to-orange-500 hover:from-amber-500 hover:to-orange-600 text-gray-900 px-6 py-3 rounded-xl font-bold transition-all hover:shadow-lg hover:scale-105"
                    >
                      <span>💝</span> Помочь {story.name.split(' ')[0]}
                    </a>
                    <a
                      href={`/news/${story.post_slug}/`}
                      class="inline-flex items-center justify-center gap-2 border border-gray-200 hover:border-primary-300 text-gray-700 hover:text-primary-700 px-6 py-3 rounded-xl font-medium transition-colors"
                    >
                      Читать историю →
                    </a>
                  </div>
                </div>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="text-center py-12">
          <div class="text-6xl mb-4">💛</div>
          <h3 class="text-2xl font-semibold text-gray-700 mb-2">Сейчас активных сборов нет</h3>
          <p class="text-gray-500">Все текущие сборы закрыты — спасибо всем, кто помог!</p>
        </div>
      )}
    </div>
  </section>

  <!-- Закрытые сборы: соц. доказательство -->
  {closedStories.length > 0 && (
    <section class="py-14 bg-white">
      <div class="container mx-auto px-4">
        <div class="text-center mb-10">
          <span class="inline-block bg-emerald-100 text-emerald-700 px-4 py-1 rounded-full text-sm font-medium mb-3">
            ✅ Сборы завершены
          </span>
          <h2 class="text-2xl md:text-3xl font-bold text-gray-900">
            Спасибо! Эти сборы закрыты
          </h2>
          <p class="text-gray-600 mt-3 max-w-xl mx-auto">
            Благодаря вашей помощи дети прошли лечение и реабилитацию.
            Мы доводим каждый сбор до конца — и отчитываемся о результатах.
          </p>
        </div>

        <div class="grid gap-6 md:grid-cols-2 max-w-4xl mx-auto">
          {closedStories.map((story) => (
            <article class="bg-white rounded-3xl shadow-lg overflow-hidden border border-emerald-100 transition-all duration-300 group hover:shadow-xl flex flex-col relative opacity-90 hover:opacity-100">
              <a href={`/news/${story.post_slug}/`} class="absolute inset-0 z-10" aria-label={`История: ${story.name}`}></a>
              <div class="relative h-48 overflow-hidden">
                {story.image ? (
                  <img
                    src={story.image}
                    alt={story.name}
                    class={`w-full h-full object-cover ${POS_CLASS[story.image_pos] || ''} group-hover:scale-105 transition-transform duration-500`}
                    loading="lazy"
                  />
                ) : (
                  <div class="w-full h-full bg-gradient-to-br from-emerald-300 to-green-400 flex items-center justify-center">
                    <span class="text-7xl">👦</span>
                  </div>
                )}
                <span class="absolute top-4 left-4 inline-flex items-center gap-1.5 bg-emerald-500/95 backdrop-blur-sm text-white px-3 py-1.5 rounded-full text-xs font-bold shadow-lg">
                  ✅ Сбор закрыт — спасибо!
                </span>
              </div>
              <div class="p-6 flex flex-col flex-1">
                <h3 class="text-xl font-bold text-gray-900">{story.name}</h3>
                <p class="text-gray-500 text-sm mt-1">{story.age} • {story.condition}</p>
                <p class="text-gray-600 mt-3 leading-relaxed flex-1 text-sm">{story.goal}</p>
                <p class="text-sm font-medium text-emerald-600 mt-4">
                  Как всё прошло →
                </p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- CTA -->
  <section class="py-14 bg-gray-50">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto text-center">
        <div class="bg-gradient-to-br from-gray-900 to-gray-800 rounded-3xl p-10 md:p-16 text-white relative overflow-hidden">
          <div class="absolute top-0 right-0 w-64 h-64 bg-primary-500 rounded-full blur-3xl opacity-20 -translate-y-1/2 translate-x-1/2"></div>

          <div class="relative z-10">
            <h3 class="text-3xl md:text-4xl font-bold mb-4">
              Хотите помочь?
            </h3>
            <p class="text-gray-300 text-lg mb-8 max-w-xl mx-auto">
              Любая сумма важна. Вместе мы можем изменить жизнь этих детей к лучшему.
            </p>
            <a
              href="/help/"
              class="inline-flex items-center gap-2 bg-gradient-to-r from-amber-400 to-orange-500 hover:from-amber-500 hover:to-orange-600 text-gray-900 px-8 py-4 rounded-full font-bold transition-all hover:shadow-xl hover:scale-105"
            >
              <span>💝</span> Выбрать способ помощи
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
