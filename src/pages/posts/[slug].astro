---
import Layout from '../../layouts/Layout.astro';
import fundData from '../../data/fund.json';

export function getStaticPaths() {
  return fundData.posts.map((post) => {
    return {
      params: { slug: post.slug },
      props: { post },
    };
  });
}

const { post } = Astro.props;
const { fund_info, bank_details } = fundData;

// Получение иконки для типа поста
function getPostIcon(type: string) {
  switch(type) {
    case 'pinned': return '📌';
    case 'event': return '🎉';
    case 'video': return '🎬';
    case 'call_to_action': return '📢';
    default: return '📝';
  }
}

// Получение цвета для типа поста
function getPostGradient(type: string) {
  switch(type) {
    case 'pinned': return 'from-amber-500 to-orange-600';
    case 'event': return 'from-green-500 to-emerald-600';
    case 'video': return 'from-purple-500 to-violet-600';
    case 'call_to_action': return 'from-blue-500 to-indigo-600';
    default: return 'from-gray-500 to-gray-600';
  }
}

// Форматирование даты
const displayDate = post.date.includes('ago') ? post.date : post.date;

// Проверяем есть ли медиа
const hasMedia = post.media && post.media.length > 0;
const hasVideoThumb = hasMedia && post.media.some(m => m.type === 'video_thumb');
const hasImages = hasMedia && post.media.some(m => m.type === 'image');
---

<Layout title={`${post.title} — БФ «Достижение-Дети»`} description={post.content.substring(0, 160)}>
  <!-- Post Hero -->
  <section class={`relative py-16 md:py-24 bg-gradient-to-br ${getPostGradient(post.type)} overflow-hidden`}>
    <div class="absolute inset-0 bg-[url('data:image/svg+xml,%3Csvg%20width%3D%2260%22%20height%3D%2260%22%20viewBox%3D%220%200%2060%2060%22%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%3E%3Cg%20fill%3D%22none%22%20fill-rule%3D%22evenodd%22%3E%3Cg%20fill%3D%22%23ffffff%22%20fill-opacity%3D%220.1%22%3E%3Ccircle%20cx%3D%2230%22%20cy%3D%2230%22%20r%3D%224%22%2F%3E%3C%2Fg%3E%3C%2Fg%3E%3C%2Fsvg%3E')]"></div>
    
    <div class="container mx-auto px-4 relative z-10">
      <div class="max-w-4xl mx-auto">
        <!-- Breadcrumb -->
        <nav class="flex items-center gap-2 text-white/80 text-sm mb-8">
          <a href="/" class="hover:text-white transition-colors">Главная</a>
          <span>/</span>
          <a href="/news" class="hover:text-white transition-colors">Новости</a>
          <span>/</span>
          <span class="text-white">Пост #{post.id}</span>
        </nav>

        <!-- Post Meta -->
        <div class="flex flex-wrap items-center gap-4 mb-6">
          <span class="inline-flex items-center gap-2 bg-white/20 backdrop-blur-sm rounded-full px-4 py-2 text-white">
            <span class="text-xl">{getPostIcon(post.type)}</span>
            <span class="font-medium capitalize">{post.type === 'pinned' ? 'Важное' : post.type === 'video' ? 'Видео' : post.type === 'event' ? 'Мероприятие' : 'Новость'}</span>
          </span>
          
          {post.has_video && (
            <span class="inline-flex items-center gap-2 bg-red-500/80 backdrop-blur-sm rounded-full px-4 py-2 text-white">
              <span>▶️</span>
              <span class="font-medium">{post.video_duration}</span>
            </span>
          )}
          
          <span class="text-white/70">
            📅 {displayDate}
          </span>
        </div>

        <!-- Title -->
        <h1 class="text-3xl md:text-5xl font-bold text-white mb-6 leading-tight">
          {post.title}
        </h1>

        <!-- Author & Stats -->
        <div class="flex flex-wrap items-center gap-6 text-white/90">
          <div class="flex items-center gap-2">
            <img 
              src={fund_info.avatar} 
              alt={fund_info.name}
              class="w-10 h-10 rounded-full border-2 border-white/30 object-cover"
            />
            <span>{post.author || fund_info.name}</span>
          </div>
          
          <div class="flex items-center gap-4 text-sm">
            <span class="flex items-center gap-1">❤️ {post.reactions}</span>
            <span class="flex items-center gap-1">💬 {post.comments_count || 0}</span>
            {post.shares && (
              <span class="flex items-center gap-1">🔗 {post.shares}</span>
            )}
          </div>
        </div>
      </div>
    </div>
    
    <div class="absolute bottom-0 left-0 right-0">
      <svg viewBox="0 0 1440 120" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full">
        <path d="M0 120L60 110C120 100 240 80 360 70C480 60 600 60 720 65C840 70 960 80 1080 85C1200 90 1320 90 1380 90L1440 90V120H1380C1320 120 1200 120 1080 120C960 120 840 120 720 120C600 120 480 120 360 120C240 120 120 120 60 120H0Z" fill="#f9fafb"/>
      </svg>
    </div>
  </section>

  <!-- Post Content -->
  <article class="py-12 bg-gray-50">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        
        <!-- Media Gallery -->
        {hasMedia && (
          <div class="mb-10">
            {/* Single Video Thumb */}
            {hasVideoThumb && !hasImages && (
              <div class="relative rounded-3xl overflow-hidden shadow-2xl group cursor-pointer">
                <img 
                  src={post.media.find(m => m.type === 'video_thumb').url}
                  alt={post.media.find(m => m.type === 'video_thumb').alt}
                  class="w-full aspect-video object-cover group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                />
                
                {/* Video Overlay */}
                <div class="absolute inset-0 bg-black/30 group-hover:bg-black/40 transition-colors flex items-center justify-center">
                  <div class="relative">
                    <!-- Play Button -->
                    <div class="w-24 h-24 bg-white/90 backdrop-blur-sm rounded-full flex items-center justify-center group-hover:scale-110 transition-transform shadow-2xl">
                      <div class="w-20 h-20 bg-gradient-to-br from-primary-500 to-primary-600 rounded-full flex items-center justify-center pl-1">
                        <svg class="w-10 h-10 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                      </div>
                    </div>
                    
                    <!-- Duration Badge -->
                    <div class="absolute -bottom-2 -right-2 bg-black/80 text-white px-3 py-1 rounded-full text-sm font-medium backdrop-blur-sm">
                      ▶️ {post.video_duration || '0:46'}
                    </div>
                  </div>
                </div>
                
                <!-- Caption */}
                {post.media.find(m => m.type === 'video_thumb').caption && (
                  <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/80 via-black/40 to-transparent p-6 pt-20">
                    <p class="text-white text-lg font-medium">
                      🎬 {post.media.find(m => m.type === 'video_thumb').caption}
                    </p>
                  </div>
                )}
                
                <!-- VK Link Overlay -->
                <a 
                  href={`https://vk.ru/dostigenie_deti`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="absolute top-4 right-4 bg-[#0077FF] hover:bg-[#0066DD] text-white px-4 py-2 rounded-lg text-sm font-medium transition-all flex items-center gap-2 backdrop-blur-sm"
                >
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M13.162 18.994c.609 0 .858-.406.851-.915-.031-1.917.714-2.949 2.059-1.604 1.488 1.488 1.796 2.519 3.603 2.519h3.2c.808 0 1.126-.26 1.126-.668 0-.863-1.421-2.386-2.625-3.504-1.686-1.565-1.765-1.602-.313-3.486 1.801-2.339 4.157-5.336 1.847-5.336h-3.316c-.715 0-1.078.375-1.346.75-.043.06-.086.12-.13.179-.579.81-1.212 1.495-1.956 1.495-.79 0-.982-.527-1.031-1.363-.063-1.083.016-2.319.016-3.435 0-.99-.185-1.392-1.155-1.556-.24-.043-.48-.073-.72-.09C11.045 1.14 9.88 1 9.295 1 7.33 1 6.073 2.02 6.82 2.255c1.148.355 1.143 1.706 1.143 3.504 0 .963-.177 2.188-.89 2.188-.776 0-1.503-.97-2.383-2.175C3.896 4.68 3.41 4.006 2.985 4.006H.643c-.346 0-.563.165-.628.44-.057.24-.015.52.108.785.86 1.78 3.967 6.54 8.554 6.54 1.876 0 2.485-.778 2.485-1.778z"/></svg>
                  Смотреть в ВК
                </a>
              </div>
            )}

            {/* Image Gallery (multiple images or single image without video) */}
            {(hasImages && !hasVideoThumb) && (
              <div class={`grid ${post.media.filter(m => m.type === 'image').length > 1 ? 'grid-cols-1 md:grid-cols-2 gap-4' : 'grid-cols-1'}`}>
                {post.media.filter(m => m.type === 'image').map((media, index) => (
                  <figure key={index} class={`rounded-2xl overflow-hidden shadow-xl group ${index === 0 && post.media.filter(m => m.type === 'image').length > 1 ? 'md:row-span-2' : ''}`}>
                    <div class="relative overflow-hidden">
                      <img 
                        src={media.url}
                        alt={media.alt}
                        class="w-full object-cover group-hover:scale-105 transition-transform duration-500 cursor-pointer"
                        loading="lazy"
                        style={index === 0 && post.media.filter(m => m.type === 'image').length > 1 ? 'min-height: 400px;' : 'max-height: 300px;'}
                      />
                      
                      {/* Hover Overlay */}
                      <div class="absolute inset-0 bg-black/0 group-hover:bg-black/20 transition-colors flex items-center justify-center opacity-0 group-hover:opacity-100">
                        <div class="bg-white/90 rounded-full p-3 shadow-lg transform scale-75 group-hover:scale-100 transition-transform">
                          <svg class="w-6 h-6 text-gray-800" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v6m3-3H7"/>
                          </svg>
                        </div>
                      </div>
                    </div>
                    
                    {/* Caption */}
                    {media.caption && (
                      <figcaption class="bg-white p-4 border-t border-gray-100">
                        <p class="text-gray-700 text-sm flex items-start gap-2">
                          <span>📸</span>
                          <span>{media.caption}</span>
                        </p>
                      </figcaption>
                    )}
                  </figure>
                ))}
              </div>
            )}

            {/* Mixed Media (Video + Images) */}
            {hasVideoThumb && hasImages && (
              <div class="space-y-4">
                {/* Video First */}
                <div class="relative rounded-3xl overflow-hidden shadow-2xl group cursor-pointer">
                  <img 
                    src={post.media.find(m => m.type === 'video_thumb').url}
                    alt={post.media.find(m => m.type === 'video_thumb').alt}
                    class="w-full aspect-video object-cover group-hover:scale-105 transition-transform duration-500"
                    loading="lazy"
                  />
                  
                  <div class="absolute inset-0 bg-black/30 group-hover:bg-black/40 transition-colors flex items-center justify-center">
                    <div class="w-20 h-20 bg-white/90 backdrop-blur-sm rounded-full flex items-center justify-center group-hover:scale-110 transition-transform shadow-2xl">
                      <div class="w-16 h-16 bg-gradient-to-br from-primary-500 to-primary-600 rounded-full flex items-center justify-center pl-1">
                        <svg class="w-8 h-8 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                      </div>
                    </div>
                  </div>
                  
                  <div class="absolute bottom-4 left-4 right-4 bg-black/70 backdrop-blur-sm rounded-lg p-3 text-white">
                    <p class="font-medium">🎬 {post.media.find(m => m.type === 'video_thumb').caption || 'Видео доступно в группе ВК'} ({post.video_duration})</p>
                  </div>
                  
                  <a 
                    href={`https://vk.ru/dostigenie_deti`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="absolute top-4 right-4 bg-[#0077FF] hover:bg-[#0066DD] text-white px-4 py-2 rounded-lg text-sm font-medium transition-all flex items-center gap-2 backdrop-blur-sm"
                  >
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M13.162 18.994c.609 0 .858-.406.851-.915-.031-1.917.714-2.949 2.059-1.604 1.488 1.488 1.796 2.519 3.603 2.519h3.2c.808 0 1.126-.26 1.126-.668 0-.863-1.421-2.386-2.625-3.504-1.686-1.565-1.765-1.602-.313-3.486 1.801-2.339 4.157-5.336 1.847-5.336h-3.316c-.715 0-1.078.375-1.346.75-.043.06-.086.12-.13.179-.579.81-1.212 1.495-1.956 1.495-.79 0-.982-.527-1.031-1.363-.063-1.083.016-2.319.016-3.435 0-.99-.185-1.392-1.155-1.556-.24-.043-.48-.073-.72-.09C11.045 1.14 9.88 1 9.295 1 7.33 1 6.073 2.02 6.82 2.255c1.148.355 1.143 1.706 1.143 3.504 0 .963-.177 2.188-.89 2.188-.776 0-1.503-.97-2.383-2.175C3.896 4.68 3.41 4.006 2.985 4.006H.643c-.346 0-.563.165-.628.44-.057.24-.015.52.108.785.86 1.78 3.967 6.54 8.554 6.54 1.876 0 2.485-.778 2.485-1.778z"/></svg>
                    Смотреть в ВК
                  </a>
                </div>

                {/* Then Images */}
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                  {post.media.filter(m => m.type === 'image').map((media, index) => (
                    <figure key={index} class="rounded-2xl overflow-hidden shadow-xl group bg-white">
                      <div class="relative overflow-hidden">
                        <img 
                          src={media.url}
                          alt={media.alt}
                          class="w-full h-64 object-cover group-hover:scale-105 transition-transform duration-500 cursor-pointer"
                          loading="lazy"
                        />
                        
                        <div class="absolute inset-0 bg-black/0 group-hover:bg-black/20 transition-colors flex items-center justify-center opacity-0 group-hover:opacity-100">
                          <div class="bg-white/90 rounded-full p-2 shadow-lg">
                            <svg class="w-5 h-5 text-gray-800" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v6m3-3H7"/>
                            </svg>
                          </div>
                        </div>
                      </div>
                      
                      {media.caption && (
                        <figcaption class="p-3 border-t border-gray-100">
                          <p class="text-gray-600 text-xs flex items-start gap-2">
                            <span>📸</span>
                            <span>{media.caption}</span>
                          </p>
                        </figcaption>
                      )}
                    </figure>
                  ))}
                </div>
              </div>
            )}
          </div>
        )}

        <!-- Content Card -->
        <div class="bg-white rounded-3xl shadow-xl overflow-hidden">
          <!-- Content Body -->
          <div class="p-8 md:p-12 prose prose-lg max-w-none">
            {/* Render markdown-like content */}
            <div class="text-gray-700 leading-relaxed space-y-6">
              {post.full_content.split('\n').map((line, index) => {
                // Headers
                if (line.startsWith('### ')) {
                  return <h3 key={index} class="text-xl font-bold text-gray-900 mt-8 mb-4">{line.replace('### ', '')}</h3>;
                }
                // Bold text with **
                if (line.startsWith('**') && line.endsWith('**')) {
                  return <p key={index} class="font-semibold text-lg text-gray-900">{line.replace(/\*\*/g, '')}</p>;
                }
                // Blockquotes
                if (line.startsWith('> ')) {
                  return <blockquote key={index} class="border-l-4 border-primary-500 pl-4 italic text-gray-600 bg-primary-50 py-3 pr-4 rounded-r-lg my-6">{line.replace('> ', '')}</blockquote>;
                }
                // Horizontal rules
                if (line === '---') {
                  return <hr key={index} class="my-8 border-gray-200" />;
                }
                // Lists
                if (line.startsWith('- ') || line.startsWith('1. ') || line.startsWith('2. ') || line.startsWith('3. ')) {
                  return <li key={index} class="ml-6 list-disc text-gray-700">{line.replace(/^[-\d.\s]+/, '')}</li>;
                }
                // Empty lines
                if (line.trim() === '') {
                  return <div key={index} class="h-4"></div>;
                }
                // Regular paragraphs
                if (line.trim()) {
                  return <p key={index}>{line.replace(/\*\*/g, '')}</p>;
                }
                return null;
              })}
            </div>

            {/* Tags */}
            {post.tags && post.tags.length > 0 && (
              <div class="mt-10 pt-8 border-t border-gray-200">
                <h4 class="text-sm font-medium text-gray-500 mb-3">Теги:</h4>
                <div class="flex flex-wrap gap-2">
                  {post.tags.map((tag) => (
                    <span class="bg-gray-100 hover:bg-primary-100 text-gray-600 hover:text-primary-700 px-3 py-1 rounded-full text-sm transition-colors cursor-pointer">
                      #{tag}
                    </span>
                  ))}
                </div>
              </div>
            )}

            {/* Comments Preview */}
            {post.commenters && post.commenters.length > 0 && (
              <div class="mt-10 pt-8 border-t border-gray-200">
                <h4 class="text-sm font-medium text-gray-500 mb-4">Комментарии:</h4>
                <div class="space-y-3">
                  {post.commenters.map((commenter) => (
                    <div class="flex items-start gap-3 bg-gray-50 rounded-lg p-3">
                      <div class="w-8 h-8 bg-gradient-to-br from-primary-400 to-primary-600 rounded-full flex items-center justify-center text-white text-xs font-bold flex-shrink-0">
                        {commenter.charAt(0)}
                      </div>
                      <div>
                        <p class="font-medium text-gray-900 text-sm">{commenter}</p>
                        <p class="text-gray-500 text-xs">Оставил(а) комментарий</p>
                      </div>
                    </div>
                  ))}
                </div>
                <a 
                  href={`https://vk.ru/dostigenie_deti`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 mt-4 text-primary-600 hover:text-primary-700 font-medium text-sm transition-colors"
                >
                  <span>Все комментарии в группе ВК →</span>
                </a>
              </div>
            )}
          </div>
        </div>

        <!-- CTA Card -->
        <div class="mt-10 bg-gradient-to-br from-primary-50 to-blue-50 rounded-3xl p-8 md:p-10 border border-primary-100">
          <div class="md:flex items-center justify-between gap-8">
            <div>
              <h3 class="text-2xl font-bold text-gray-900 mb-2">
                Хотите помочь?
              </h3>
              <p class="text-gray-600">
                Ваша поддержка меняет жизнь наших детей. Каждый вклад важен!
              </p>
            </div>
            
            <div class="flex flex-col sm:flex-row gap-3 mt-4 md:mt-0">
              <a 
                href="/help"
                class="bg-primary-500 hover:bg-primary-600 text-white px-6 py-3 rounded-xl font-semibold transition-all hover:shadow-lg text-center"
              >
                ❤️ Помочь детям
              </a>
              <a 
                href={`https://vk.ru/dostigenie_deti`}
                target="_blank"
                rel="noopener noreferrer"
                class="bg-[#0077FF] hover:bg-[#0066DD] text-white px-6 py-3 rounded-xl font-semibold transition-all hover:shadow-lg text-center inline-flex items-center justify-center gap-2"
              >
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M13.162 18.994c.609 0 .858-.406.851-.915-.031-1.917.714-2.949 2.059-1.604 1.488 1.488 1.796 2.519 3.603 2.519h3.2c.808 0 1.126-.26 1.126-.668 0-.863-1.421-2.386-2.625-3.504-1.686-1.565-1.765-1.602-.313-3.486 1.801-2.339 4.157-5.336 1.847-5.336h-3.316c-.715 0-1.078.375-1.346.75-.043.06-.086.12-.13.179-.579.81-1.212 1.495-1.956 1.495-.79 0-.982-.527-1.031-1.363-.063-1.083.016-2.319.016-3.435 0-.99-.185-1.392-1.155-1.556-.24-.043-.48-.073-.72-.09C11.045 1.14 9.88 1 9.295 1 7.33 1 6.073 2.02 6.82 2.255c1.148.355 1.143 1.706 1.143 3.504 0 .963-.177 2.188-.89 2.188-.776 0-1.503-.97-2.383-2.175C3.896 4.68 3.41 4.006 2.985 4.006H.643c-.346 0-.563.165-.628.44-.057.24-.015.52.108.785.86 1.78 3.967 6.54 8.554 6.54 1.876 0 2.485-.778 2.485-1.778z"/></svg>
                ВК группа
              </a>
            </div>
          </div>
        </div>

        <!-- Navigation -->
        <div class="mt-10 flex items-center justify-between">
          <a 
            href="/news"
            class="inline-flex items-center gap-2 text-gray-600 hover:text-primary-600 font-medium transition-colors"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
            Назад к новостям
          </a>
          
          <a 
            href={`https://vk.ru/dostigenie_deti`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 text-[#0077FF] hover:text-[#0066DD] font-medium transition-colors"
          >
